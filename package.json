{
  "name": "found-hint",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.admin.config.js",
    "start": "npm run dev",
    "lint": "npx eslint src",
    "build": "vite build --config vite.admin.config.js",
    "plugin:prepare": "npm run build && node scripts/build.cjs",
    "plugin:publish": "npm run plugin:prepare && node scripts/zip.cjs"
